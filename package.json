{
  "name": "windows-capture-excluded-overlay",
  "version": "1.0.0",
  "description": "Minimal Electron overlay for Windows that stays visible locally while requesting capture exclusion via SetWindowDisplayAffinity.",
  "productName": "Screnshield",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "start:dev": "set VITE_DEV_SERVER_URL=http://localhost:5173&& electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "overlay",
    "windows",
    "screen-capture",
    "ffi"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "dompurify": "^3.4.5",
    "electron": "^30.5.1",
    "electron-builder": "^26.0.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "vite": "^8.0.8",
    "vue": "^3.5.32"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "ffi-napi": "^4.0.3",
    "ref-napi": "^3.0.3"
  },
  "build": {
    "appId": "com.vsatish.invisibleoverlay",
    "productName": "Screnshield",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "dist-vue/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  }
}
