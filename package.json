{
  "name": "screnshield",
  "version": "1.0.0",
  "description": "Personal Windows overlay that answers interview questions from live audio, pasted text or a screenshot, using OpenAI.",
  "productName": "Screnshield",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "start": "electron .",
    "start:dev": "set VITE_DEV_SERVER_URL=http://localhost:5173&& electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "overlay",
    "windows",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "dompurify": "^3.4.5",
    "electron": "^30.5.1",
    "electron-builder": "^26.0.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "vite": "^8.0.8",
    "vitest": "^5.0.2",
    "vue": "^3.5.32"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.vsatish.screnshield",
    "productName": "Screnshield",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      "dist-vue/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  }
}
